Step 3: Create Student.js
Inside src, create a new file named Student.js.

Copy and paste this complete code:

import React from "react";

// Initial student data
const studlist = [
  {
    slno: 1,
    name: "stud1",
    usn: "rvce1",
    tmarks: 150
  },
  {
    slno: 2,
    name: "stud2",
    usn: "rvce2",
    tmarks: 145
  }
];

// Component 1: Display a single student
class StudentRow extends React.Component {
  render() {
    const studl = this.props.stdli;

    return (
      <tr>
        <td>{studl.slno}</td>
        <td>{studl.name}</td>
        <td>{studl.usn}</td>
        <td>{studl.tmarks}</td>
      </tr>
    );
  }
}

// Component 2: Display all students in a table
class StudentsTable extends React.Component {
  render() {
    const studrows = this.props.studlist.map(studli => (
      <StudentRow
        key={studli.slno}
        stdli={studli}
      />
    ));

    return (
      <table border="1" cellPadding="8">
        <thead>
          <tr>
            <th>Sl No</th>
            <th>Student Name</th>
            <th>USN</th>
            <th>Total Marks</th>
          </tr>
        </thead>

        <tbody>
          {studrows}
        </tbody>
      </table>
    );
  }
}

// Component 3: Manage the student list
class StudentListTable extends React.Component {
  constructor() {
    super();

    this.state = {
      newStudList: []
    };
  }

  componentDidMount() {
    this.loadData();
  }

  // Load initial students after 1 second
  loadData() {
    setTimeout(() => {
      this.setState({
        newStudList: studlist
      });
    }, 1000);

    // Add another student after 2 seconds
    setTimeout(() => {
      this.loadupdate();
    }, 2000);
  }

  // Add the third student
  loadupdate() {
    const newstudlist1 = this.state.newStudList.slice();

    const stud = {
      slno: 3,
      name: "rvce12",
      usn: "rvce12",
      tmarks: 250
    };

    newstudlist1.push(stud);

    this.setState({
      newStudList: newstudlist1
    });
  }

  render() {
    return (
      <React.Fragment>
        <h2>Student Registration Portal</h2>

        <hr />

        <StudentsTable
          studlist={this.state.newStudList}
        />

        <hr />
      </React.Fragment>
    );
  }
}

export default StudentListTable;



