6. Comparison Selectors
A. Greater Than ($gt) and Less Than or Equal ($lte)
db.employees.find({
  salary: {
    $gt: 90000,
    $lte: 120000
  }
})


B. In ($in)
db.employees.find({
  department: {
    $in: ["HR", "Sales"]
  }
})


C. Not Equal ($ne)
db.employees.find({
  status: {
    $ne: "On Leave"
  }
})


7. Logical Selectors
A. AND ($and)
db.employees.find({
  department: "Engineering",
  performance_score: {
    $gte: 4.5
  }
})


B. OR ($or)
db.employees.find({
  $or: [
    { department: "HR" },
    { salary: { $gt: 100000 } }
  ]
})


8. Combining Selectors for a Complex Query
db.employees.find({
  status: "Active",
  department: {
    $in: ["Engineering", "Sales"]
  },
  hire_date: {
    $lt: new Date("2024-01-01")
  }
})


